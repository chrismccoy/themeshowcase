# Sample Settings for the theme previewer.

# The name you sign in with.
ADMIN_USERNAME=admin

# The hashed password. Run `npm run set-password`, which asks for a password
# and prints this line for you to paste in.
ADMIN_PASSWORD_HASH=

# Any long random string. It signs the cookie that remembers you are signed in.
# To make one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The port to listen on.
PORT=3000

# Set this to "production" when the site is live and reachable over HTTPS.
# NODE_ENV=production

# DATABASE_FILE=data/themes.db
# UPLOAD_DIR=data/uploads

# The largest screenshot anybody may upload, in bytes. The default is 5 MB.
# MAX_IMAGE_BYTES=5242880

# Shown in place of a theme's screenshot when its file is missing
# FALLBACK_IMAGE=/img/placeholder.svg

# The name and icon of the dashboard. The icon is a Font Awesome name, from the
# free solid and regular sets
# BRAND_NAME=Theme Previewer
# BRAND_ICON=fa-solid fa-swatchbook

# Links shown in the header of the public page
# NAV_LINKS=Github|https://github.com/you, Directory|https://example.com/themes

# How long being signed in lasts, in hours.
# SESSION_TTL_HOURS=168

# How many wrong passwords one address may try
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MINUTES=15

# Limit the dashboard area
# ADMIN_ALLOWED_IPS=203.0.113.4, 192.168.1.0/24, 2001:db8::/32, ::1, 127.0.0.1

# Set this whenever anything sits in front of the app, such as nginx, Caddy or Cloudflare.
# TRUST_PROXY=1
