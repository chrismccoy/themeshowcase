<header class="sticky top-0 z-10 flex h-16 items-center gap-3 border-b border-slate-200 bg-white/80 px-4 backdrop-blur sm:px-6">
  <span class="text-sm font-medium text-slate-500 lg:hidden"><%= brand.name %></span>
  <span class="flex-1"></span>
  <span class="flex items-center gap-2 rounded-full border border-slate-200 bg-white py-1 pl-1 pr-2.5 text-sm text-slate-600">
    <span class="grid h-6 w-6 place-items-center rounded-full bg-brand-600 text-[11px] font-semibold text-white"><%= adminUser.slice(0, 1).toUpperCase() %></span>
    <%= adminUser %>
  </span>
</header>

<nav class="flex flex-nowrap items-center gap-1 overflow-x-auto whitespace-nowrap border-b border-slate-200 bg-white px-4 py-2 text-sm lg:hidden">
  <a href="/admin/themes" class="rounded px-2 py-1 <%= active === 'themes' ? 'font-medium text-brand-600' : 'text-slate-500' %>">Themes</a>
  <a href="/admin/categories" class="rounded px-2 py-1 <%= active === 'categories' ? 'font-medium text-brand-600' : 'text-slate-500' %>">Categories</a>
</nav>
